# Copy this file to env/.env.local and fill in the values.
# env/.env.local is ignored by git and never uploaded to Railway.

# https://developer.company-information.service.gov.uk/ (REST API key)
COMPANIES_HOUSE_API_KEY=

# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Password for the deployed site. Any username works. Leave empty for no password.
APP_PASSWORD=

# Only needed to run locally. Railway sets its own.
DATABASE_URL=
